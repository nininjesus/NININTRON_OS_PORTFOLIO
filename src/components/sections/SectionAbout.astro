---
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import Output from '../primitives/Output.astro';
import TerminalHeader from '../primitives/TerminalHeader.astro';
import Separator from '../primitives/Separator.astro';
import { t } from '../../i18n/index';
import '../../styles/components/section-about.css';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const aboutData = t(lang, 'about');
const aboutGroups = Object.values(aboutData).map((group: any) => group.items);
const sectionTitle = t(lang, 'nav.sobre_mi.label').toUpperCase() + '.TXT';
const commandTitle = 'cat /' + t(lang, 'nav.sobre_mi.label') + '.txt';
const ariaLabel = t(lang, 'aria.sobre_mi');
---

<Panel sectionId="sobre-mi" ariaLabel={ariaLabel} title={sectionTitle}>
  <PanelMain>
    
    <TerminalHeader command={commandTitle} />
    
    <div class="terminal-content-list">
      <Separator />
      {aboutGroups.map((group, index) => (
        <>
          {group.map((item) => (
            <Output text={`${item.label}: ${item.value}`} />
          ))}
          {index < aboutGroups.length - 1 && <Separator />}
        </>
      ))}
    </div>
    
  </PanelMain>
</Panel>
