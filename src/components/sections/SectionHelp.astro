---
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import TerminalHeader from '../primitives/TerminalHeader.astro';
import Output from '../primitives/Output.astro';
import Separator from '../primitives/Separator.astro';
import { t } from '../../i18n/index';
import '../../styles/components/section-help.css';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const helpLines = t(lang, 'help.lines');
const sectionTitle = t(lang, 'nav.ayuda.label').toUpperCase() + '.TXT';
const commandTitle = 'man ' + t(lang, 'nav.ayuda.label');
const ariaLabel = t(lang, 'aria.ayuda');
---

<Panel sectionId="ayuda" ariaLabel={ariaLabel} title={sectionTitle}>
  <PanelMain>
    
    <TerminalHeader command={commandTitle} />

    <div class="terminal-content-list">
      <Separator />

      {helpLines.map((line: string) => {
        if (line === "---") return <Separator />;
        
        // Add margin-bottom to specific lines based on known structural markers
        const isHeader = line.includes(":") && !line.startsWith("[");
        const isLastCommand = line.startsWith("[5]");
        const className = (isHeader || isLastCommand) ? "margin-bottom" : "";
        
        return <Output text={line} class={className} />;
      })}
    </div>
    
  </PanelMain>
</Panel>
